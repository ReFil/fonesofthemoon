[event]
type=registration
transport=transport-udp
outbound_auth=event_auth
server_uri=sip:__EVENT_SIP_SERVER__
client_uri=sip:__EVENT_ASTERISK_NUMBER__@__EVENT_SIP_SERVER__
contact_user=__EVENT_ASTERISK_NUMBER__
retry_interval=60

[event_auth]
type=auth
auth_type=userpass
username=__EVENT_ASTERISK_NUMBER__
password=__EVENT_ASTERISK_SECRET__

[event_endpoint]
type=endpoint
transport=transport-udp
context=from-event
disallow=all
allow=ulaw
allow=alaw
allow=g722
allow=g729
outbound_auth=event_auth
aors=event_aor
media_address=__ASTERISK_PUBLIC_IP__
from_domain=__EVENT_SIP_SERVER__
direct_media=no
rtp_symmetric=yes
force_rport=yes
# With this enabled sip packets get all sorts of skrunkled
; rewrite_contact=yes

[event_aor]
type=aor
contact=sip:__EVENT_SIP_SERVER__

[event_identify]
type=identify
endpoint=event_endpoint
match=__EVENT_SIP_SERVER_IP__
